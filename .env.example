# ==============================================================================
# Smart License Server — Example Environment Configuration (.env.example)
# ==============================================================================
#
# This file is the template the installer reads to produce your production
# `.env` file.
#
# MARKER & INSTALLER BEHAVIOR
# ----------------------------
# The installer parses this file and copies everything between the
# `<SMLISER-PRODUCTION-BEGIN>` and `<SMLISER-PRODUCTION-END>` markers below,
# verbatim, into the target `.env` file in your production environment root.
#
# Nothing outside the markers (including this preamble) is copied. Maintainers:
# keep every production environment variable, and any comment documenting it,
# inside the marker boundary — anything placed outside it will silently not
# reach installations.
#
# HOW TO USE THIS FILE
# ----------------------------
# 1. Copy the marked section to `.env` in your project root.
# 2. Fill in every variable marked "Required" below.
# 3. Leave optional variables blank to use their documented default.
# 4. Never commit your real `.env` file — see the SECURITY section inside
#    the markers for the full guidance.
# ==============================================================================

# <SMLISER-PRODUCTION-BEGIN>
# ==============================================================================
# Smart License Server — Environment Configuration (.env)
# ==============================================================================
#
# SECURITY
# --------
# • Never commit your .env file to version control.
# • Add ".env" to your .gitignore.
# • Restrict read access to the user account running Smart License Server.
#
# All Smart License Server environment variables are prefixed with
# "SMLISER_" to avoid collisions with other applications.
# ==============================================================================


# ==============================================================================
# APPLICATION
# ==============================================================================
#
# SMLISER_APP_URL
#   Public URL of this Smart License Server installation. Do not include a
#   trailing slash.
#
#   Required.
#
#   Example:
#     https://licenses.example.com
# ==============================================================================

SMLISER_APP_URL=


# ==============================================================================
# ERROR HANDLING
# ==============================================================================
#
# SMLISER_DEBUG
#   Enables debug mode (verbose internal logging, relaxed error suppression).
#   Keep this disabled in production.
#
# SMLISER_DISPLAY_ERRORS
#   Displays raw PHP errors in the browser response. This must always be
#   disabled in production — it can leak file paths, stack traces, and other
#   internal details to visitors.
#
# SMLISER_ERROR_LOG_PATH
#   Absolute path to the file PHP errors are logged to. Leave blank to use
#   the platform's default error log location.
#
# Defaults:
#   SMLISER_DEBUG=false
#   SMLISER_DISPLAY_ERRORS=false
#   SMLISER_ERROR_LOG_PATH=  (platform default)
# ==============================================================================

SMLISER_DEBUG=false
SMLISER_DISPLAY_ERRORS=false
SMLISER_ERROR_LOG_PATH=


# ==============================================================================
# DATABASE
# ==============================================================================
#
# SMLISER_DB_DRIVER
#   Which database backend to connect to.
#
#   Required.
#
#   Supported values:
#     mysql
#     pgsql
#     sqlite
#
# The variables you need to fill in below depend on the driver you chose:
#
#   mysql / pgsql  → fill in the "MySQL / PostgreSQL" block.
#   sqlite         → fill in the "SQLite" block, plus SMLISER_DB_NAME
#                     from the "MySQL / PostgreSQL" block above it (used
#                     there as the SQLite filename) — the rest of that
#                     block can stay blank.
# ==============================================================================

SMLISER_DB_DRIVER=

# ------------------------------------------------------------------------------
# MySQL / PostgreSQL
# ------------------------------------------------------------------------------
#
# Required when SMLISER_DB_DRIVER is "mysql" or "pgsql":
#   SMLISER_DB_HOST, SMLISER_DB_PORT, SMLISER_DB_NAME,
#   SMLISER_DB_USER, SMLISER_DB_PASSWORD
#
# SMLISER_DB_HOST
#   Database server hostname or IP address. Use 127.0.0.1 instead of
#   "localhost" to force a TCP connection rather than a local socket.
#
# SMLISER_DB_PORT
#   Database server port (typically 3306 for MySQL, 5432 for PostgreSQL).
#
# SMLISER_DB_NAME
#   Name of the database to connect to (mysql/pgsql). Also used when
#   SMLISER_DB_DRIVER is "sqlite" — see the SQLite block below for how
#   it's applied there.
#
# SMLISER_DB_USER
#   Database username.
#
# SMLISER_DB_PASSWORD
#   Database password. Leave empty only if the database account genuinely
#   has no password (not recommended in production).
#
# SMLISER_DB_CHARSET
#   Database character set/encoding. Valid values depend on the driver:
#
#     mysql / mariadb  → utf8mb4 (recommended — supports full Unicode,
#                         including emoji)
#     pgsql            → UTF8 (PostgreSQL does not recognize "utf8mb4")
#
#   Not used when SMLISER_DB_DRIVER is "sqlite".
#
# SMLISER_DB_PREFIX
#   Prefix applied to every table name, useful when sharing a database with
#   other applications. Leave empty to disable table prefixing.
#
# Defaults:
#   SMLISER_DB_CHARSET=utf8mb4 (mysql/mariadb), UTF8 (pgsql)
#   SMLISER_DB_PREFIX=smliser_
# ------------------------------------------------------------------------------

SMLISER_DB_HOST=
SMLISER_DB_PORT=
SMLISER_DB_NAME=
SMLISER_DB_USER=
SMLISER_DB_PASSWORD=
SMLISER_DB_CHARSET=utf8mb4
SMLISER_DB_PREFIX=smliser_

# ------------------------------------------------------------------------------
# SQLite
# ------------------------------------------------------------------------------
#
# Required when SMLISER_DB_DRIVER is "sqlite":
#   SMLISER_DB_PATH, SMLISER_DB_NAME (shared with the MySQL/PostgreSQL
#   block above)
#
# SMLISER_DB_PATH
#   Absolute path to the DIRECTORY the SQLite database file is kept in —
#   not the file itself.
#
#   Example:
#     /var/www/html/storage
#
# SMLISER_DB_NAME
#   Used here as the SQLite database file's name, resolved inside
#   SMLISER_DB_PATH. If the value has no file extension at all, ".db" is
#   appended automatically — purely so the resulting file is recognizable
#   to the OS and other tools as a SQLite database; the value itself
#   isn't sqlite-specific, which lets you reuse the same SMLISER_DB_NAME
#   (e.g. one that names a real mysql/pgsql database) when switching
#   SMLISER_DB_DRIVER to "sqlite" for local testing or mocking.
#
#   Example:
#     SMLISER_DB_NAME=smliser        → smliser.db
#     SMLISER_DB_NAME=smliser.db     → smliser.db   (already has an extension, unchanged)
#     SMLISER_DB_NAME=smliser.sqlite → smliser.sqlite (already has an extension, unchanged)
#
# SMLISER_SQLITE_ENCRYPTION_KEY
#   Optional encryption key for the SQLite database file. Leave blank to
#   store the database unencrypted.
# ------------------------------------------------------------------------------

SMLISER_DB_PATH=
SMLISER_SQLITE_ENCRYPTION_KEY=


# ==============================================================================
# FILESYSTEM
# ==============================================================================
#
# Repository and storage paths. Leave blank to use the default locations.
#
# SMLISER_REPO_PATH
#   Root directory where application packages, releases, and their metadata
#   are stored.
#
#   Default:
#     dirname( SMLISER_PATH )
#
# SMLISER_UPLOADS_DIR
#   Directory user uploads are written to.
#
#   Default:
#     SMLISER_REPO_PATH/uploads
# ==============================================================================

SMLISER_REPO_PATH=
SMLISER_UPLOADS_DIR=


# ==============================================================================
# CLI
# ==============================================================================
#
# Settings for the smliser command-line tool.
#
# SMLISER_CLI_LOGO
#   Controls which ASCII logo (if any) the interactive shell prints in its
#   welcome banner.
#
#   Supported values:
#     auto        - Derive the logo from output verbosity (default).
#     large       - Always print the large logo.
#     monospaced  - Always print the compact monospaced logo.
#     short       - Always print the short logo.
#     none        - Never print a logo.
#
#   Unrecognized or empty values fall back to "auto".
#
# Default:
#   auto
# ==============================================================================

SMLISER_CLI_LOGO=auto


# ==============================================================================
# CACHE
# ==============================================================================
#
# SMLISER_CACHE_ADAPTER
#   Default cache adapter, used at application startup and as the fallback
#   if the adapter an administrator configured later is invalid or
#   unavailable.
#
#   Supported values:
#     runtime      - Request-local in-memory cache. No persistence, no
#                     setup — good default for getting started.
#     apcu         - APCu shared memory cache. Requires the APCu PHP
#                     extension.
#     memcached    - Memcached server. Requires a running Memcached
#                     instance and the Memcached PHP extension.
#     redis        - Redis server. Requires a running Redis instance and
#                     the Redis PHP extension.
#     sqlitecache  - SQLite-backed persistent cache. Survives restarts
#                     without needing a separate cache server.
#
# Default:
#   runtime
# ==============================================================================

SMLISER_CACHE_ADAPTER=runtime


# ==============================================================================
# EMAIL
# ==============================================================================
#
# SMLISER_EMAIL_PROVIDER
#   Default email provider, used at application startup and as the fallback
#   if the provider an administrator configured later is invalid,
#   unavailable, or misconfigured.
#
#   Supported values:
#     php_mail    - PHP's built-in mail() function. No setup, but often
#                    unreliable for deliverability — fine for local
#                    development, not recommended for production.
#     smtp        - Any SMTP server — see the "SMTP" block below.
#     brevo       - Brevo (formerly Sendinblue) — see "Brevo" below.
#     sendgrid    - SendGrid — see "SendGrid" below.
#     mailgun     - Mailgun — see "Mailgun" below.
#     postmark    - Postmark — see "Postmark" below.
#     resend      - Resend — see "Resend" below.
#     amazon_ses  - Amazon SES — see "Amazon SES" below.
#
#   Only fill in the block matching the provider you chose; the rest can
#   stay blank.
#
# Default:
#   php_mail
# ==============================================================================

SMLISER_EMAIL_PROVIDER=php_mail


# ------------------------------------------------------------------------------
# SMTP
# ------------------------------------------------------------------------------
#
# Required when SMLISER_EMAIL_PROVIDER is "smtp".
#
# SMLISER_SMTP_HOST         SMTP server hostname.
# SMLISER_SMTP_PORT         SMTP server port (587 is the common default for
#                           TLS submission).
# SMLISER_SMTP_USERNAME     SMTP authentication username.
# SMLISER_SMTP_PASSWORD     SMTP authentication password.
# SMLISER_SMTP_ENCRYPTION   Connection encryption: "tls", "ssl", or "none".
# SMLISER_SMTP_FROM_ADDRESS Email address outgoing mail is sent from.
# SMLISER_SMTP_FROM_NAME    Display name outgoing mail is sent as.
#
# Default:
#   SMLISER_SMTP_PORT=587
#   SMLISER_SMTP_ENCRYPTION=tls
# ------------------------------------------------------------------------------

SMLISER_SMTP_HOST=
SMLISER_SMTP_PORT=587
SMLISER_SMTP_USERNAME=
SMLISER_SMTP_PASSWORD=
SMLISER_SMTP_ENCRYPTION=tls
SMLISER_SMTP_FROM_ADDRESS=
SMLISER_SMTP_FROM_NAME=


# ------------------------------------------------------------------------------
# Brevo
# ------------------------------------------------------------------------------
#
# Required when SMLISER_EMAIL_PROVIDER is "brevo".
#
# SMLISER_BREVO_API_KEY   API key from your Brevo account.
# ------------------------------------------------------------------------------

SMLISER_BREVO_API_KEY=


# ------------------------------------------------------------------------------
# SendGrid
# ------------------------------------------------------------------------------
#
# Required when SMLISER_EMAIL_PROVIDER is "sendgrid".
#
# SMLISER_SENDGRID_API_KEY   API key from your SendGrid account.
# ------------------------------------------------------------------------------

SMLISER_SENDGRID_API_KEY=


# ------------------------------------------------------------------------------
# Mailgun
# ------------------------------------------------------------------------------
#
# Required when SMLISER_EMAIL_PROVIDER is "mailgun".
#
# SMLISER_MAILGUN_API_KEY   API key from your Mailgun account.
# SMLISER_MAILGUN_DOMAIN    Verified sending domain configured in Mailgun.
# ------------------------------------------------------------------------------

SMLISER_MAILGUN_API_KEY=
SMLISER_MAILGUN_DOMAIN=


# ------------------------------------------------------------------------------
# Postmark
# ------------------------------------------------------------------------------
#
# Required when SMLISER_EMAIL_PROVIDER is "postmark".
#
# SMLISER_POSTMARK_SERVER_TOKEN   Server token from your Postmark account.
# ------------------------------------------------------------------------------

SMLISER_POSTMARK_SERVER_TOKEN=


# ------------------------------------------------------------------------------
# Resend
# ------------------------------------------------------------------------------
#
# Required when SMLISER_EMAIL_PROVIDER is "resend".
#
# SMLISER_RESEND_API_KEY   API key from your Resend account.
# ------------------------------------------------------------------------------

SMLISER_RESEND_API_KEY=


# ------------------------------------------------------------------------------
# Amazon SES
# ------------------------------------------------------------------------------
#
# Required when SMLISER_EMAIL_PROVIDER is "amazon_ses".
#
# SMLISER_AWS_ACCESS_KEY_ID       AWS access key with SES send permissions.
# SMLISER_AWS_SECRET_ACCESS_KEY   AWS secret access key.
# SMLISER_AWS_DEFAULT_REGION      AWS region your SES sending identity is
#                                 verified in (e.g. us-east-1).
# ------------------------------------------------------------------------------

SMLISER_AWS_ACCESS_KEY_ID=
SMLISER_AWS_SECRET_ACCESS_KEY=
SMLISER_AWS_DEFAULT_REGION=


# ==============================================================================
# SECURITY
# ==============================================================================
#
# Generate long, cryptographically secure random values for every variable
# in this section — e.g. `openssl rand -base64 48`. Never reuse these
# secrets across different Smart License Server installations, and never
# reuse the same value between two of the three variables below.
#
# SMLISER_CLI_API_KEY   Secret used to authenticate CLI API requests.
# SMLISER_SECRET        Application secret.
# SMLISER_SALT          Application salt.
# ==============================================================================

SMLISER_CLI_API_KEY=
SMLISER_SECRET=
SMLISER_SALT=
# <SMLISER-PRODUCTION-END>
