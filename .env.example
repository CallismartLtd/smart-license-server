# ==============================================================================
# Smart License Server — Environment Configuration (.env)
# ==============================================================================
#
# Copy this file to ".env" in the application root and update the values for
# your environment.
#
# SECURITY
# --------
# • Never commit your .env file to version control.
# • Add ".env" to your .gitignore.
# • Restrict read access to the user account running Smart License Server.
#
# All Smart License Server environment variables are prefixed with
# "SMLISER_" to avoid collisions with other applications.
# ==============================================================================


# ==============================================================================
# APPLICATION
# ==============================================================================
#
# Public URL of the Smart License Server installation.
#
# Required.
#
# Example:
#   https://licenses.example.com
#
# Do not include a trailing slash.
# ==============================================================================

SMLISER_APP_URL=


# ==============================================================================
# ERROR HANDLING
# ==============================================================================
#
# Controls PHP error handling.
#
# SMLISER_DEBUG
#   Enables debug mode.
#
# SMLISER_DISPLAY_ERRORS
#   Displays PHP errors in the browser.
#   This should always be disabled in production.
# ==============================================================================

SMLISER_DEBUG=false
SMLISER_DISPLAY_ERRORS=false
SMLISER_ERROR_LOG_PATH=


# ==============================================================================
# DATABASE
# ==============================================================================
#
# Database connection settings.
#
# Supported drivers:
#
#   mysql
#   pgsql
#   sqlite
#
# Required:
#   SMLISER_DB_DRIVER
#
# MySQL and PostgreSQL require:
#
#   SMLISER_DB_HOST
#   SMLISER_DB_PORT
#   SMLISER_DB_NAME
#   SMLISER_DB_USER
#   SMLISER_DB_PASSWORD
#
# SQLite requires:
#
#   SMLISER_DB_PATH
# ==============================================================================

# Database driver.
SMLISER_DB_DRIVER=

# ------------------------------------------------------------------------------
# MySQL / PostgreSQL
# ------------------------------------------------------------------------------

# Database server hostname or IP address.
#
# Use 127.0.0.1 instead of "localhost" to force a TCP connection.
SMLISER_DB_HOST=

# Database server port.
SMLISER_DB_PORT=

# Database name.
SMLISER_DB_NAME=

# Database username.
SMLISER_DB_USER=

# Database password.
#
# Leave empty only if the database account has no password.
SMLISER_DB_PASSWORD=

# Database character set.
#
# utf8mb4 is recommended.
SMLISER_DB_CHARSET=utf8mb4

# Database table prefix.
#
# Leave empty to disable table prefixing.
SMLISER_DB_PREFIX=smliser_

# ------------------------------------------------------------------------------
# SQLite
# ------------------------------------------------------------------------------

# Absolute path to the SQLite database file.
#
# Example:
#   /var/www/html/storage/database.sqlite
SMLISER_DB_PATH=
SMLISER_SQLITE_ENCRYPTION_KEY=


# ==============================================================================
# FILESYSTEM
# ==============================================================================
#
# Repository and storage paths.
#
# Leave blank to use the default locations.
# ==============================================================================

# Repository root.
#
# Stores application packages, releases and metadata.
#
# Default:
#   dirname( SMLISER_PATH )
SMLISER_REPO_PATH=

# Uploads directory.
#
# Default:
#   SMLISER_REPO_PATH/uploads
SMLISER_UPLOADS_DIR=


# ==============================================================================
# CACHE
# ==============================================================================
#
# Default cache adapter.
#
# This value is used during application startup and serves as the fallback if
# the cache adapter configured by an administrator is invalid or unavailable.
#
# Supported values:
#
#   runtime      - Request-local in-memory cache.
#   apcu         - APCu shared memory cache.
#   memcached    - Memcached server.
#   redis        - Redis server.
#   sqlitecache  - SQLite-backed persistent cache.
#
# Default:
#   runtime
# ==============================================================================

SMLISER_CACHE_ADAPTER=runtime


# ==============================================================================
# EMAIL
# ==============================================================================
#
# Default email provider.
#
# This value is used during application startup and serves as the fallback if
# the email provider configured by an administrator is invalid, unavailable or
# misconfigured.
#
# Supported values:
#
#   php_mail
#   smtp
#   brevo
#   sendgrid
#   mailgun
#   postmark
#   resend
#   amazon_ses
#
# Default:
#   php_mail
# ==============================================================================

SMLISER_EMAIL_PROVIDER=php_mail


# ------------------------------------------------------------------------------
# SMTP
# ------------------------------------------------------------------------------

SMLISER_SMTP_HOST=
SMLISER_SMTP_PORT=587
SMLISER_SMTP_USERNAME=
SMLISER_SMTP_PASSWORD=
SMLISER_SMTP_ENCRYPTION=tls
SMLISER_SMTP_FROM_ADDRESS=
SMLISER_SMTP_FROM_NAME=


# ------------------------------------------------------------------------------
# Brevo
# ------------------------------------------------------------------------------

SMLISER_BREVO_API_KEY=


# ------------------------------------------------------------------------------
# SendGrid
# ------------------------------------------------------------------------------

SMLISER_SENDGRID_API_KEY=


# ------------------------------------------------------------------------------
# Mailgun
# ------------------------------------------------------------------------------

SMLISER_MAILGUN_API_KEY=
SMLISER_MAILGUN_DOMAIN=


# ------------------------------------------------------------------------------
# Postmark
# ------------------------------------------------------------------------------

SMLISER_POSTMARK_SERVER_TOKEN=


# ------------------------------------------------------------------------------
# Resend
# ------------------------------------------------------------------------------

SMLISER_RESEND_API_KEY=


# ------------------------------------------------------------------------------
# Amazon SES
# ------------------------------------------------------------------------------

SMLISER_AWS_ACCESS_KEY_ID=
SMLISER_AWS_SECRET_ACCESS_KEY=
SMLISER_AWS_DEFAULT_REGION=


# ==============================================================================
# SECURITY
# ==============================================================================
#
# Generate long, cryptographically secure random values for these settings.
#
# Never reuse secrets across different Smart License Server installations.
# ==============================================================================

# Secret used to authenticate CLI API requests.
SMLISER_CLI_API_KEY=

# Application secret.
SMLISER_SECRET=

# Application salt.
SMLISER_SALT=