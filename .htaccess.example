# ==============================================================================
# Smart License Server — Apache Configuration
# ==============================================================================
#
# DEVELOPMENT DOCUMENTATION
# ------------------------------------------------------------------------------
#
# This file is an example configuration intended for development and packaging.
#
# The production .htaccess generated by the build process should contain only
# the configuration between the markers below.
#
# ==============================================================================

# <SMLISER-PRODUCTION-BEGIN>

<IfModule mod_rewrite.c>

    RewriteEngine On

    # Preserve existing files and directories.
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Route all remaining requests through the application front controller.
    RewriteRule ^ index.php [L]

</IfModule>

# <SMLISER-PRODUCTION-END>

# ==============================================================================
# END OF CONFIGURATION
# ==============================================================================