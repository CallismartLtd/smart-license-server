# ==============================================================================
# Smart License Server — Example Apache Configuration (.htaccess.example)
# ==============================================================================
#
# This file serves as an example Apache configuration template for the 
# Smart License Server installation and build process.
#
# MARKER & INSTALLER BEHAVIOR:
# ----------------------------
# The installer and build tools automatically parse this file and extract 
# everything bounded between the `<SMLISER-PRODUCTION-BEGIN>` and 
# `<SMLISER-PRODUCTION-END>` markers below.
#
# During installation or packaging, the content inside these markers is 
# copied directly to create the target `.htaccess` file in the root directory 
# of your production environment.
#
# Maintainers: Keep all production rewrite rules, headers, and server directives 
# within the marker boundary.
# ==============================================================================

# <SMLISER-PRODUCTION-BEGIN>
# ==============================================================================
# Smart License Server — Apache Environment Directives (.htaccess)
# ==============================================================================

<IfModule mod_rewrite.c>

    RewriteEngine On

    # Preserve existing files and directories.
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Route all remaining requests through the application front controller.
    RewriteRule ^ index.php [L]

</IfModule>
# <SMLISER-PRODUCTION-END>